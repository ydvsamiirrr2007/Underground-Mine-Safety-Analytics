# ==========================================
# MINE SAFETY MONITORING SYSTEM
# Environment Configuration
# ==========================================
# IMPORTANT: Copy this file to .env and fill in your values
# NEVER commit the actual .env file to version control
# ==========================================

# ========== SYSTEM ==========
SYSTEM_MODE=simulation
LOG_LEVEL=INFO
TIMEZONE=UTC

# ========== DATABASE ==========
# SQLite (default for development)
DB_TYPE=sqlite
DB_SQLITE_PATH=data/mine_safety.db

# PostgreSQL (for production)
# DB_TYPE=postgresql
# DB_POSTGRESQL_HOST=localhost
# DB_POSTGRESQL_PORT=5432
# DB_POSTGRESQL_DATABASE=mine_safety
# DB_POSTGRESQL_USER=mine_user
# DB_POSTGRESQL_PASSWORD=your_secure_password_here

# ========== API ==========
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
API_WORKERS=4

# ========== FRONTEND ==========
FRONTEND_PORT=3000
FRONTEND_API_BASE_URL=http://localhost:8000

# ========== HARDWARE ==========
HARDWARE_MODE=simulation
RASPBERRY_PI_ENABLED=false
GPIO_MODE=BCM
I2C_BUS=1

# ========== SENSORS ==========
# Set individual sensor status
SENSOR_GAS_ENABLED=true
SENSOR_TEMPERATURE_ENABLED=true
SENSOR_HUMIDITY_ENABLED=true
SENSOR_VIBRATION_ENABLED=true
SENSOR_PRESSURE_ENABLED=true
SENSOR_SMOKE_ENABLED=true
SENSOR_MOTION_ENABLED=true

# ========== MONITORING ==========
SENSOR_READ_INTERVAL=5
SENSOR_HEALTH_INTERVAL=30
DATA_SYNC_INTERVAL=60

# ========== RISK ENGINE ==========
RISK_THRESHOLD_LOW=25
RISK_THRESHOLD_MEDIUM=50
RISK_THRESHOLD_HIGH=75
ANOMALY_DETECTION_ENABLED=true
ANOMALY_CONTAMINATION=0.05

# ========== FORECASTING ==========
FORECASTING_ENABLED=true
FORECAST_HORIZON_MINUTES=15
MIN_HISTORY_FOR_FORECAST=30

# ========== ALERTS ==========
ALERT_ENABLED=true
BUZZER_ENABLED=true
LEDS_ENABLED=true
ALERT_THRESHOLD_CRITICAL=85

# ========== LOGGING ==========
LOG_DIR=logs
LOG_FILE_NAME=mine_safety.log
LOG_MAX_SIZE_MB=10
LOG_BACKUP_COUNT=5

# ========== FEATURES ==========
ENABLE_RISK_EXPLANATION=true
ENABLE_WHAT_IF_SIMULATION=true
ENABLE_FORECASTING=true
ENABLE_SENSOR_HEALTH=true
ENABLE_ANOMALY_DETECTION=true

# ========== DATA RETENTION ==========
DATA_RETENTION_DAYS=90
PREDICTION_RETENTION_DAYS=30
ANOMALY_RETENTION_DAYS=30
ALERT_RETENTION_DAYS=90

# ========== SIMULATION SCENARIOS ==========
# normal, gas_rising, smoke_event, temperature_rise, multi_hazard, sensor_failure, recovery
SIMULATION_SCENARIO=normal
SIMULATION_SEED=42
